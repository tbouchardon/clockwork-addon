<Ui xmlns="http://www.blizzard.com/wow/ui/"
>
    <Frame name="ClockWorkMenuFrame"
           parent="WorldFrame"
           movable="true"
           hidden="false"
           inherits="BackdropTemplate">

<!--        <KeyValues>-->
<!--            <KeyValue key="backdropInfo" value="BACKDROP_TUTORIAL_16_16" type="global"/>-->
<!--        </KeyValues>-->

        <Scripts>
            <OnLoad>
                self:RegisterForDrag("LeftButton")

                ClockWorkMenuFrame.Expand = function()
                ClockWorkMenuFrame:SetWidth(137)
                ClockWorkMenuFrame:SetHeight(204)

                MyScriptOptionsButtonToggle:Show()
                MyScriptOptionsButtonTNE:Show()
                MyScriptOptionsButtonAddWP:Show()
                MyScriptOptionsButtonClearWP:Show()
                MyScriptOptionsButtonDrive:Show()
                MyScriptOptionsButtonLoop:Show()
                MyScriptOptionsButtonDebug:Show()
                MyScriptOptionsButtonAggro:Show()
                end

                ClockWorkMenuFrame.Collapse = function()
                ClockWorkMenuFrame:SetWidth(137)
                ClockWorkMenuFrame:SetHeight(20)

                MyScriptOptionsButtonToggle:Hide()
                MyScriptOptionsButtonTNE:Hide()
                MyScriptOptionsButtonAddWP:Hide()
                MyScriptOptionsButtonClearWP:Hide()
                MyScriptOptionsButtonDrive:Hide()
                MyScriptOptionsButtonLoop:Hide()
                MyScriptOptionsButtonDebug:Hide()
                MyScriptOptionsButtonAggro:Hide()
                end

                self:OnBackdropLoaded()
                self:OnBackdropSizeChanged()
            </OnLoad>
            <OnEnter>
                ClockWorkMenuFrame:Expand()
            </OnEnter>
            <OnLeave>
                -- ClockWorkMenuFrame.Collapse()
            </OnLeave>
            <OnDragStart>
                self:StartMoving()
            </OnDragStart>
            <OnDragStop>
                self:StopMovingOrSizing()
            </OnDragStop>
        </Scripts>
        <Size x="137"
              y="204"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Frames>

            <Frame name="$parent_TitleBar">

                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="3"
                                          y="-8"/>
                        </Offset>
                    </Anchor>
                    <Anchor point="BOTTOMRIGHT"
                            relativePoint="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-3"
                                          y="-13"/>
                        </Offset>
                    </Anchor>
                </Anchors>

                <Layers>
                    <Layer level="ARTWORK">
                        <FontString name="$parent_Title"
                                    inherits="GameFontNormalSmall"
                                    text="ClockWork"
                                    justifyH="CENTER">
                            <Color r="1"
                                   g="1"
                                   b="1"/>
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                                <Anchor point="BOTTOMRIGHT"/>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <Frame name="$parent_Controls">
                <Scripts>
                    <OnUpdate>
                        local f = GetMouseFocus()
                        if (f) then

                        local found = false
                        while (f:GetParent() and f:GetParent() ~= UIParent) do
                        if (f == ClockWorkMenuFrame) then found = true end
                        f = f:GetParent()
                        end

                        if (not found) then
                        ClockWorkMenuFrame:Collapse()
                        end
                        end
                    </OnUpdate>
                </Scripts>
                <Anchors>
                    <Anchor point="TOPLEFT"
                            relativeTo="$parent_TitleBar"
                            relativePoint="BOTTOMLEFT"/>
                    <Anchor point="BOTTOMRIGHT">
                        <Offset>
                            <AbsDimension x="-3"
                                          y="3"/>
                        </Offset>
                    </Anchor>
                </Anchors>

                <Frames>

                    <Button name="MyScriptOptionsButtonToggle"
                            inherits="OptionsButtonTemplate"
                            text="Off - Toggle">
                        <Size x="120"
                              y="25"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"
                                    relativePoint="TOPLEFT">
                                <Offset x="5"
                                        y="-5"/>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                self.tooltip = "Toggle ClockWork On/Off";
                            </OnLoad>
                            <OnEnter>
                                GameTooltip:SetOwner(self, "ANCHOR_LEFT");
                                GameTooltip:SetText(self.tooltip);
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide();
                            </OnLeave>
                            <OnClick>
                                clockWork.clickToggle()
                                if clockWork.TOGGLE_ON_OFF == false
                                then
                                MyScriptOptionsButtonToggle:SetText("Off - Toggle")
                                else
                                MyScriptOptionsButtonToggle:SetText("On - Toggle")
                                end
                                -- clockWork.print(tostring(MyScriptOptionsButtonToggle:GetPushedTexture()))
                                -- clockWork.print(tostring(MyScriptOptionsButtonToggle:GetNormalTexture()))
                            </OnClick>
                        </Scripts>
                    </Button>

                    <Button name="MyScriptOptionsButtonAggro"
                            inherits="OptionsButtonTemplate"
                            text="On - Aggro">
                        <Size x="120"
                              y="25"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"
                                    relativeTo="MyScriptOptionsButtonToggle"
                                    relativePoint="BOTTOMLEFT">
                                <Offset x="0"
                                        y="0"/>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                self.tooltip = "Allow Aggro in combat On/Off";
                            </OnLoad>
                            <OnEnter>
                                GameTooltip:SetOwner(self, "ANCHOR_LEFT");
                                GameTooltip:SetText(self.tooltip);
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide();
                            </OnLeave>
                            <OnClick>
                                if clockWork.AGGRO_MOD == false
                                then
                                clockWork.AGGRO_MOD = true
                                MyScriptOptionsButtonAggro:SetText("On - Aggro")
                                clockWork.print("Aggro Mod : On")
                                else
                                clockWork.AGGRO_MOD = false
                                MyScriptOptionsButtonAggro:SetText("Off - Aggro")
                                clockWork.print("Aggro Mod : Off")
                                end
                            </OnClick>
                        </Scripts>
                    </Button>

                    <Button name="MyScriptOptionsButtonTNE"
                            inherits="OptionsButtonTemplate"
                            text="Off - TNE">
                        <Size x="120"
                              y="25"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"
                                    relativeTo="MyScriptOptionsButtonAggro"
                                    relativePoint="BOTTOMLEFT">
                                <Offset x="0"
                                        y="0"/>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                self.tooltip = "Auto Target Next Enemy On/Off";
                            </OnLoad>
                            <OnEnter>
                                GameTooltip:SetOwner(self, "ANCHOR_LEFT");
                                GameTooltip:SetText(self.tooltip);
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide();
                            </OnLeave>
                            <OnClick>
                                clockWork.clickTNE()
                                if clockWork.TARGET_NEAREST_ENEMY == false
                                then
                                MyScriptOptionsButtonTNE:SetText("Off - TNE")
                                else
                                MyScriptOptionsButtonTNE:SetText("On - TNE")
                                end
                            </OnClick>
                        </Scripts>
                    </Button>

                    <Button name="MyScriptOptionsButtonDrive"
                            inherits="OptionsButtonTemplate"
                            text="Off - Drive">
                        <Size x="120"
                              y="25"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"
                                    relativeTo="MyScriptOptionsButtonTNE"
                                    relativePoint="BOTTOMLEFT">
                                <Offset x="0"
                                        y="0"/>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                self.tooltip = "Start/Stop GPS !!";
                            </OnLoad>
                            <OnEnter>
                                GameTooltip:SetOwner(self, "ANCHOR_LEFT");
                                GameTooltip:SetText(self.tooltip);
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide();
                            </OnLeave>
                            <OnClick>
                                clockWork.clickDrive()
                                if clockWork.DRIVE_MOD == false
                                then
                                MyScriptOptionsButtonDrive:SetText("Off - Drive")
                                else
                                MyScriptOptionsButtonDrive:SetText("On - Drive")
                                end
                            </OnClick>
                        </Scripts>
                    </Button>

                    <Button name="MyScriptOptionsButtonLoop"
                            inherits="OptionsButtonTemplate"
                            text="Off - Loop WP">
                        <Size x="120"
                              y="25"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"
                                    relativeTo="MyScriptOptionsButtonDrive"
                                    relativePoint="BOTTOMLEFT">
                                <Offset x="0"
                                        y="0"/>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                self.tooltip = "Loop through waypoints";
                            </OnLoad>
                            <OnEnter>
                                GameTooltip:SetOwner(self, "ANCHOR_LEFT");
                                GameTooltip:SetText(self.tooltip);
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide();
                            </OnLeave>
                            <OnClick>
                                clockWork.clickLoop()
                                if clockWork.DRIVE_LOOP == false
                                then
                                MyScriptOptionsButtonLoop:SetText("Off - Loop WP")
                                else
                                MyScriptOptionsButtonLoop:SetText("On - Loop WP")
                                end
                            </OnClick>
                        </Scripts>
                    </Button>

                    <Button name="MyScriptOptionsButtonDebug"
                            inherits="OptionsButtonTemplate"
                            text="Off - Debug">
                        <Size x="120"
                              y="25"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"
                                    relativeTo="MyScriptOptionsButtonLoop"
                                    relativePoint="BOTTOMLEFT">
                                <Offset x="0"
                                        y="0"/>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                self.tooltip = "Toggle debug mod On/Off";
                            </OnLoad>
                            <OnEnter>
                                GameTooltip:SetOwner(self, "ANCHOR_LEFT");
                                GameTooltip:SetText(self.tooltip);
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide();
                            </OnLeave>
                            <OnClick>
                                clockWork.clickDebug()
                                if clockWork.DEBUG_MOD == false
                                then
                                MyScriptOptionsButtonDebug:SetText("Off - Debug")
                                else
                                MyScriptOptionsButtonDebug:SetText("On - Debug")
                                end
                            </OnClick>
                        </Scripts>
                    </Button>

                    <Button name="MyScriptOptionsButtonAddWP"
                            inherits="OptionsButtonTemplate"
                            text="Add Waypoint">
                        <Size x="120"
                              y="25"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"
                                    relativeTo="MyScriptOptionsButtonDebug"
                                    relativePoint="BOTTOMLEFT">
                                <Offset x="0"
                                        y="0"/>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                self.tooltip = "Add a waypoint at current position";
                            </OnLoad>
                            <OnEnter>
                                GameTooltip:SetOwner(self, "ANCHOR_LEFT");
                                GameTooltip:SetText(self.tooltip);
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide();
                            </OnLeave>
                            <OnClick>
                                clockWork.clickAddWp()
                            </OnClick>
                        </Scripts>
                    </Button>

                    <Button name="MyScriptOptionsButtonClearWP"
                            inherits="OptionsButtonTemplate"
                            text="Clear Waypoints">
                        <Size x="120"
                              y="25"/>
                        <Anchors>
                            <Anchor point="TOPLEFT"
                                    relativeTo="MyScriptOptionsButtonAddWP"
                                    relativePoint="BOTTOMLEFT">
                                <Offset x="0"
                                        y="0"/>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnLoad>
                                self.tooltip = "Clear every waypoints";
                            </OnLoad>
                            <OnEnter>
                                GameTooltip:SetOwner(self, "ANCHOR_LEFT");
                                GameTooltip:SetText(self.tooltip);
                            </OnEnter>
                            <OnLeave>
                                GameTooltip:Hide();
                            </OnLeave>
                            <OnClick>
                                clockWork.clickClearWp()
                            </OnClick>
                        </Scripts>
                    </Button>

                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>